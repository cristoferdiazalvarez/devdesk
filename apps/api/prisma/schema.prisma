generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

enum Status {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Category {
  ACCESS
  TECHNICAL
  BILLING
  OTHER
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  passwordHash String
  role         Role          @default(CUSTOMER)
  createdAt    DateTime      @default(now())
  tickets      Ticket[]      @relation("Owner")
  assigned     Ticket[]      @relation("Assignee")
  comments     Comment[]
  events       TicketEvent[]
  sessions     Session[]
}

model Ticket {
  id          Int           @id @default(autoincrement())
  subject     String
  description String
  priority    Priority
  status      Status        @default(OPEN)
  category    Category
  demoData    Boolean       @default(false)
  ownerId     String
  owner       User          @relation("Owner", fields: [ownerId], references: [id])
  assigneeId  String?
  assignee    User?         @relation("Assignee", fields: [assigneeId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  comments    Comment[]
  events      TicketEvent[]

  @@index([ownerId, updatedAt])
  @@index([assigneeId, updatedAt])
  @@index([updatedAt])
}

model Comment {
  id        String   @id @default(uuid())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model TicketEvent {
  id        String   @id @default(uuid())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  field     String
  before    String?
  after     String?
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model Session {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([expiresAt])
}
